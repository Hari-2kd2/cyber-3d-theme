  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#6f5b94",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#ffd670"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff9770"
      }
    },
    {
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#ff70a6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#70d6ff"
      }
    },
    {
      "scope": [
        "entity.name.type"
      ],
      "settings": {
        "foreground": "#e056fd"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#f3e8ff"
      }
    }
  ]
}