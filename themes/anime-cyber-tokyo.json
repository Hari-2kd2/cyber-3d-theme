{
  "name": "Anime Cyber Tokyo",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#70d6ff99",
    "foreground": "#f3e8ff",
    "widget.shadow": "#000000cc",
    "selection.background": "#70d6ff33",
    "descriptionForeground": "#8b7ca6",
    "errorForeground": "#ff0055",
    "titleBar.activeBackground": "#0e0a1c",
    "titleBar.activeForeground": "#70d6ff",
    "titleBar.inactiveBackground": "#0e0a1c",
    "titleBar.inactiveForeground": "#8b7ca6",
    "titleBar.border": "#150f2b",
    "activityBar.background": "#0e0a1c",
    "activityBar.foreground": "#70d6ff",
    "activityBar.inactiveForeground": "#8b7ca688",
    "activityBar.border": "#150f2b",
    "activityBarBadge.background": "#ff70a6",
    "activityBarBadge.foreground": "#ffffff",
    "activityBar.activeBorder": "#70d6ff",
    "sideBar.background": "#150f2b",
    "sideBar.foreground": "#f3e8ff",
    "sideBar.border": "#1f163f",
    "sideBarTitle.foreground": "#70d6ff",
    "sideBarSectionHeader.background": "#0e0a1c",
    "sideBarSectionHeader.foreground": "#ff70a6",
    "sideBarSectionHeader.border": "#1f163f",
    "editorGroupHeader.tabsBackground": "#0e0a1c",
    "editorGroupHeader.tabsBorder": "#1f163f",
    "tab.activeBackground": "#1f163f",
    "tab.activeForeground": "#70d6ff",
    "tab.activeBorderTop": "#70d6ff",
    "tab.inactiveBackground": "#0e0a1c",
    "tab.inactiveForeground": "#8b7ca6",
    "tab.border": "#150f2b",
    "editor.background": "#150f2b",
    "editor.foreground": "#f3e8ff",
    "editorLineNumber.foreground": "#8b7ca677",
    "editorLineNumber.activeForeground": "#70d6ff",
    "editorCursor.foreground": "#ffd670",
    "editor.selectionBackground": "#70d6ff26",
    "editor.selectionHighlightBackground": "#ff70a626",
    "editor.lineHighlightBackground": "#1f163f55",
    "editor.lineHighlightBorder": "#70d6ff22",
    "editorWhitespace.foreground": "#1f163f",
    "editorIndentGuide.background": "#1f163f88",
    "editorIndentGuide.activeBackground": "#70d6ff77",
    "editorBracketMatch.background": "#ff70a633",
    "editorBracketMatch.border": "#ff70a6",
    "statusBar.background": "#0e0a1c",
    "statusBar.foreground": "#8b7ca6",
    "statusBar.border": "#70d6ff33",
    "statusBar.debuggingBackground": "#ff70a6",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#70d6ff22",
    "statusBarItem.remoteBackground": "#70d6ff",
    "statusBarItem.remoteForeground": "#0e0a1c",
    "terminal.background": "#0e0a1c",
    "terminal.foreground": "#f3e8ff",
    "terminalCursor.foreground": "#ffd670",
    "terminal.ansiCyan": "#70d6ff",
    "terminal.ansiMagenta": "#ff70a6",
    "terminal.ansiGreen": "#ffd670",
    "terminal.ansiYellow": "#facc15",
    "terminal.ansiBlue": "#38bdf8",
    "terminal.ansiRed": "#f43f5e",
    "button.background": "#70d6ff",
    "button.foreground": "#0e0a1c",
    "button.hoverBackground": "#70d6ffdd",
    "input.background": "#1f163f",
    "input.foreground": "#ffffff",
    "input.border": "#70d6ff55",
    "inputOption.activeBorder": "#ff70a6",
    "badge.background": "#70d6ff",
    "badge.foreground": "#0e0a1c"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8b7ca699",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffd670"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type"
      ],
      "settings": {
        "foreground": "#ff70a6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#70d6ff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f3e8ff"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#ff70a6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8b7ca6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#facc15"
      }
    }
  ]
}