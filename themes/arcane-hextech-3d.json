    "foreground": "#e0f2fe",
    "widget.shadow": "#000000cc",
    "selection.background": "#00e1d933",
    "descriptionForeground": "#38bdf8",
    "errorForeground": "#ff0055",
    "titleBar.activeBackground": "#070e17",
