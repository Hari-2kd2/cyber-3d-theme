{
  "name": "Cyber Gamer 3D",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#00e5ff99",
    "foreground": "#e2e8f0",
    "widget.shadow": "#000000cc",
    "selection.background": "#00e5ff33",
    "descriptionForeground": "#64748b",
    "errorForeground": "#ff0055",
    "titleBar.activeBackground": "#080a12",
    "titleBar.activeForeground": "#00e5ff",
    "titleBar.inactiveBackground": "#080a12",
    "titleBar.inactiveForeground": "#64748b",
    "titleBar.border": "#0d111e",
    "activityBar.background": "#080a12",
    "activityBar.foreground": "#00e5ff",
    "activityBar.inactiveForeground": "#64748b88",
    "activityBar.border": "#0d111e",
    "activityBarBadge.background": "#ff007f",
    "activityBarBadge.foreground": "#ffffff",
    "activityBar.activeBorder": "#00e5ff",
    "sideBar.background": "#0d111e",
    "sideBar.foreground": "#e2e8f0",
    "sideBar.border": "#161d33",
    "sideBarTitle.foreground": "#00e5ff",
    "sideBarSectionHeader.background": "#080a12",
    "sideBarSectionHeader.foreground": "#ff007f",
    "sideBarSectionHeader.border": "#161d33",
    "editorGroupHeader.tabsBackground": "#080a12",
    "editorGroupHeader.tabsBorder": "#161d33",
    "tab.activeBackground": "#161d33",
    "tab.activeForeground": "#00e5ff",
    "tab.activeBorderTop": "#00e5ff",
    "tab.inactiveBackground": "#080a12",
    "tab.inactiveForeground": "#64748b",
    "tab.border": "#0d111e",
    "editor.background": "#0d111e",
    "editor.foreground": "#e2e8f0",
    "editorLineNumber.foreground": "#64748b77",
    "editorLineNumber.activeForeground": "#00e5ff",
    "editorCursor.foreground": "#00ff88",
    "editor.selectionBackground": "#00e5ff26",
    "editor.selectionHighlightBackground": "#ff007f26",
    "editor.lineHighlightBackground": "#161d3355",
    "editor.lineHighlightBorder": "#00e5ff22",
    "editorWhitespace.foreground": "#161d33",
    "editorIndentGuide.background": "#161d3388",
    "editorIndentGuide.activeBackground": "#00e5ff77",
    "editorBracketMatch.background": "#ff007f33",
    "editorBracketMatch.border": "#ff007f",
    "statusBar.background": "#080a12",
    "statusBar.foreground": "#64748b",
    "statusBar.border": "#00e5ff33",
    "statusBar.debuggingBackground": "#ff007f",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#00e5ff22",
    "statusBarItem.remoteBackground": "#00e5ff",
    "statusBarItem.remoteForeground": "#080a12",
    "terminal.background": "#080a12",
    "terminal.foreground": "#e2e8f0",
    "terminalCursor.foreground": "#00ff88",
    "terminal.ansiCyan": "#00e5ff",
    "terminal.ansiMagenta": "#ff007f",
    "terminal.ansiGreen": "#00ff88",
    "terminal.ansiYellow": "#facc15",
    "terminal.ansiBlue": "#38bdf8",
    "terminal.ansiRed": "#f43f5e",
    "button.background": "#00e5ff",
    "button.foreground": "#080a12",
    "button.hoverBackground": "#00e5ffdd",
    "input.background": "#161d33",
    "input.foreground": "#ffffff",
    "input.border": "#00e5ff55",
    "inputOption.activeBorder": "#ff007f",
    "badge.background": "#00e5ff",
    "badge.foreground": "#080a12"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64748b99",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#00ff88"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type"
      ],
      "settings": {
        "foreground": "#ff007f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#00e5ff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e2e8f0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#ff007f",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#64748b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#facc15"
      }
    }
  ]
}