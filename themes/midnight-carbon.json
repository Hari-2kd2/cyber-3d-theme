{
  "name": "Midnight Carbon Minimalist",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#38bdf899",
    "foreground": "#f1f5f9",
    "widget.shadow": "#000000cc",
    "selection.background": "#38bdf833",
    "descriptionForeground": "#64748b",
    "errorForeground": "#ff0055",
    "titleBar.activeBackground": "#0e0e11",
    "titleBar.activeForeground": "#38bdf8",
    "titleBar.inactiveBackground": "#0e0e11",
    "titleBar.inactiveForeground": "#64748b",
    "titleBar.border": "#141418",
    "activityBar.background": "#0e0e11",
    "activityBar.foreground": "#38bdf8",
    "activityBar.inactiveForeground": "#64748b88",
    "activityBar.border": "#141418",
    "activityBarBadge.background": "#f43f5e",
    "activityBarBadge.foreground": "#ffffff",
    "activityBar.activeBorder": "#38bdf8",
    "sideBar.background": "#141418",
    "sideBar.foreground": "#f1f5f9",
    "sideBar.border": "#1c1c22",
    "sideBarTitle.foreground": "#38bdf8",
    "sideBarSectionHeader.background": "#0e0e11",
    "sideBarSectionHeader.foreground": "#f43f5e",
    "sideBarSectionHeader.border": "#1c1c22",
    "editorGroupHeader.tabsBackground": "#0e0e11",
    "editorGroupHeader.tabsBorder": "#1c1c22",
    "tab.activeBackground": "#1c1c22",
    "tab.activeForeground": "#38bdf8",
    "tab.activeBorderTop": "#38bdf8",
    "tab.inactiveBackground": "#0e0e11",
    "tab.inactiveForeground": "#64748b",
    "tab.border": "#141418",
    "editor.background": "#141418",
    "editor.foreground": "#f1f5f9",
    "editorLineNumber.foreground": "#64748b77",
    "editorLineNumber.activeForeground": "#38bdf8",
    "editorCursor.foreground": "#34d399",
    "editor.selectionBackground": "#38bdf826",
    "editor.selectionHighlightBackground": "#f43f5e26",
    "editor.lineHighlightBackground": "#1c1c2255",
    "editor.lineHighlightBorder": "#38bdf822",
    "editorWhitespace.foreground": "#1c1c22",
    "editorIndentGuide.background": "#1c1c2288",
    "editorIndentGuide.activeBackground": "#38bdf877",
    "editorBracketMatch.background": "#f43f5e33",
    "editorBracketMatch.border": "#f43f5e",
    "statusBar.background": "#0e0e11",
    "statusBar.foreground": "#64748b",
    "statusBar.border": "#38bdf833",
    "statusBar.debuggingBackground": "#f43f5e",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#38bdf822",
    "statusBarItem.remoteBackground": "#38bdf8",
    "statusBarItem.remoteForeground": "#0e0e11",
    "terminal.background": "#0e0e11",
    "terminal.foreground": "#f1f5f9",
    "terminalCursor.foreground": "#34d399",
    "terminal.ansiCyan": "#38bdf8",
    "terminal.ansiMagenta": "#f43f5e",
    "terminal.ansiGreen": "#34d399",
    "terminal.ansiYellow": "#facc15",
    "terminal.ansiBlue": "#38bdf8",
    "terminal.ansiRed": "#f43f5e",
    "button.background": "#38bdf8",
    "button.foreground": "#0e0e11",
    "button.hoverBackground": "#38bdf8dd",
    "input.background": "#1c1c22",
    "input.foreground": "#ffffff",
    "input.border": "#38bdf855",
    "inputOption.activeBorder": "#f43f5e",
    "badge.background": "#38bdf8",
    "badge.foreground": "#0e0e11"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64748b99",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#34d399"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#fb923c"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type"
      ],
      "settings": {
        "foreground": "#f43f5e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#38bdf8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#f1f5f9"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#f43f5e",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#f59e0b"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#64748b"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#facc15"
      }
    }
  ]
}